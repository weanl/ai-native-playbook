#!/bin/bash
# pre-push hook: block pushes to main/master branches
# Allows all other branches to push freely
# Install: git config core.hooksPath scripts/hooks

while read local_ref local_sha remote_ref remote_sha; do
    remote_branch=$(echo "$remote_ref" | sed 's|refs/heads/||')
    if [[ "$remote_branch" == "main" || "$remote_branch" == "master" ]]; then
        echo "ERROR: Pushing to '$remote_branch' is blocked by pre-push hook."
        echo "Use a PR instead: gh pr create --base main"
        exit 1
    fi
done

exit 0