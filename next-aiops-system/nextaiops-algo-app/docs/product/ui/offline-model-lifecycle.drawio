        <mxCell id="title" value="M2 当前阶段：实验与策略模拟优先，模型生命周期主流程后续承接&#xa;先比较不同数据集上的算法 / 参数 / 策略，再将胜出配置沉淀为 Train Job、Model Version 与 Promotion 事件" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1500" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="legend-priority" value="蓝色：当前优先实验闭环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#9bb7f0;fontColor=#172033;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1580" y="28" width="170" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="legend-strategy" value="紫色：策略模拟闭环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f2ff;strokeColor=#c4b5fd;fontColor=#172033;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
