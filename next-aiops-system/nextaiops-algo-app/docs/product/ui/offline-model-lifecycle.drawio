        <mxCell id="title" value="M2 离线 Model 生命周期主流程&#xa;训练数据集版本 -&gt; Train Job -&gt; Artifact -&gt; Model Version -&gt; Evidence -&gt; Active" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#172033;" vertex="1" parent="1">
