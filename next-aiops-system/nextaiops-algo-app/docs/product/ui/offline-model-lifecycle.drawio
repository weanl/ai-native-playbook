        </mxCell>

        <mxCell id="lane-a" value="优先闭环 A：数据实验与算法选择，目标是找到不同数据集下更可靠的算法 / 参数方向" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#c9d8f6;fontColor=#3b557f;fontStyle=1;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="2070" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="lane-b" value="优先闭环 B：每日新增数据后的离线策略模拟，目标是量化 auto-active 策略是否足够稳健" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f2ff;strokeColor=#c4b5fd;fontColor=#4c1d95;fontStyle=1;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="315" width="2070" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="lane-main" value="后续承接主流程：将胜出配置落成模型版本、晋级事件与 active pointer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#d8e0ea;fontColor=#526070;fontStyle=1;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="535" width="2070" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="lane-exception" value="停止与复核：训练失败、证据不足或策略退化时，不更新 active pointer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffafa;strokeColor=#f3c4c4;fontColor=#8a1f1f;fontStyle=1;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
