<mxfile host="app.diagrams.net" modified="2026-05-20T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="offline-model-lifecycle" name="离线模型生命周期">
    <mxGraphModel dx="2100" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="M2 离线 Model 生命周期主流程&#xa;主线：Training Dataset Version -&gt; Train Job -&gt; Model Artifact -&gt; Model Version(candidate) -&gt; Evidence -&gt; Manual Promotion -&gt; Active" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1640" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="legend-solid" value="实线：模型生成主链路" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#6abf9f;fontColor=#172033;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1710" y="28" width="150" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="legend-dashed" value="虚线：探索 / 证据支线" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#eef4ff;strokeColor=#9bb7f0;fontColor=#172033;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1875" y="28" width="170" height="32" as="geometry"/>
        </mxCell>

        <mxCell id="band-main" value="主流程：真正产生并激活模型版本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#d8e0ea;fontColor=#526070;fontStyle=1;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="2005" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="band-exception" value="异常分支：失败或证据不足时停止在当前对象" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffafa;strokeColor=#f3c4c4;fontColor=#8a1f1f;fontStyle=1;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="2005" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="band-support" value="支线：实验、批量比较、当前 active baseline 与晋级审计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#c9d8f6;fontColor=#3b557f;fontStyle=1;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="2005" height="125" as="geometry"/>
        </mxCell>
