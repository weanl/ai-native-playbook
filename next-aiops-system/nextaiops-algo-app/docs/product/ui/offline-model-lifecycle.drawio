  <diagram id="offline-model-lifecycle" name="离线模型生命周期">
    <mxGraphModel dx="2200" dy="1040" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1040" math="0" shadow="0">
